<a href="{{ path('board_show', {'id': board.id}) }}" class="block bg-white p-4 rounded-lg border border-slate-200 hover:border-indigo-500 transition">
    <div class="flex justify-between items-start mb-2">
        <h3 class="font-bold text-slate-800 text-base">{{ board.name }}</h3>
        <span class="text-xs bg-slate-100 px-2 py-0.5 rounded text-slate-600">
            Tasks: {{ board.countTask }}
        </span>
    </div>
    <div class="text-xs text-indigo-600 font-medium text-right mt-4">
        Otwórz tablicę
    </div>
    <div class="text-xs text-indigo-600 font-medium text-right mt-2">
        <form method="POST" action="{{ path('board_delete', {'id': board.id}) }}" onsubmit="return confirm('Na pewno chcesz usunąć tablicę?');">
            <button type="submit" class="hover:text-rose-700 cursor-pointer">Usuń tablicę</button>
        </form>
    </div>
</a>
