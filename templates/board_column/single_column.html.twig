<div id="column_{{ column.id }}" class="bg-slate-100 rounded-lg p-4 border border-slate-200 w-full md:w-80 shrink-0">
    <div class="flex justify-between items-center mb-3">
        <h3 class="font-bold text-slate-700 text-sm flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-slate-400"></span>
            {{ column.name }}
        </h3>
        <span class="text-xs font-bold text-slate-500 bg-white border border-slate-200 px-1.5 py-0.5 rounded">
            {{ column.tasks|length }}
        </span>
    </div>

    <div class="space-y-3">
        {% for task in column.tasks %}
            <div class="bg-white p-3 rounded border border-slate-200 shadow-sm">
                <h4 class="font-bold text-slate-800 text-sm">{{ task.title }}</h4>
            </div>
        {% else %}
            <div class="text-center p-4 border border-dashed border-slate-300 rounded text-slate-400 text-xs italic">
                Brak zadań
            </div>
        {% endfor %}
    </div>
</div>
