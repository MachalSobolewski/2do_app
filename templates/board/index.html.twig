{% extends 'base.html.twig' %}

{% block body %}
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="md:col-span-1 bg-white p-5 rounded-lg border border-slate-200 h-fit">
            <h3 class="font-bold text-slate-800 mb-4 text-sm uppercase">Nowa tablica</h3>

            {% for message in app.flashes('success') %}
                <div class="mb-4 p-3 bg-green-50 text-green-700 text-xs rounded border border-green-200">
                    {{ message }}
                </div>
            {% endfor %}

            {{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}
            {{ form_row(form.name) }}
            {{ form_row(form.save) }}
            {{ form_end(form) }}
        </div>
        <div class="md:col-span-3">
            <h2 class="text-xl font-bold text-slate-800 mb-4">Twoje tablice ({{ boards|length }})</h2>

            {% if boards is empty %}
                <div class="bg-white border border-slate-200 rounded-lg p-8 text-center text-slate-400 text-sm">
                    Brak utworzonych tablic. Użyj formularza po lewej stronie.
                </div>
            {% else %}
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                    {% for board in boards %}
                        <twig:Board :board="board" />
                    {% endfor %}
                </div>

            {% endif %}
        </div>
    </div>
{% endblock %}
