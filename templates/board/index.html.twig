{% extends 'base.html.twig' %}

{% block title %}Moje Tablice Kanban{% endblock %}

{% block body %}
<div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    <div class="lg:col-span-1">
        <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm sticky top-6">
            <h2 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
                <span>➕</span> Nowa tablica
            </h2>
            {% for message in app.flashes('success') %}
                <div class="mb-4 p-3 bg-emerald-50 text-emerald-700 text-xs rounded-lg border border-emerald-200">
                    {{ message }}
                </div>
            {% endfor %}

            <form method="POST" class="space-y-4">
                <input type="hidden" name="_token" value="{{ csrf_token('add_board') }}">

                <div>
                    <label for="name" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Nazwa tablicy</label>
                    <input type="text" id="name" name="name" required placeholder="np. Projekt Sklepu, Domowe..."
                           class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition">
                </div>

                <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-4 rounded-lg text-sm shadow-sm transition">
                    Utwórz tablicę
                </button>
            </form>
        </div>
    </div>

    <div class="lg:col-span-3">
        <h2 class="text-xl font-bold text-slate-800 mb-6 flex items-center gap-2">
            <span>🗂️</span> Twoje aktywne tablice
            <span class="text-sm font-normal text-slate-400">({{ boards|length }})</span>
        </h2>

        {% if boards is empty %}
        <!-- Stan pusty (Gdy nie ma tablic) -->
        <div class="bg-white border border-dashed border-slate-300 rounded-xl p-12 text-center">
            <div class="text-4xl mb-3">📁</div>
            <h3 class="text-md font-semibold text-slate-700">Brak tablic</h3>
            <p class="text-sm text-slate-400 mt-1 max-w-sm mx-auto">Nie masz jeszcze żadnej tablicy projektowej. Użyj formularza po lewej stronie, aby stworzyć swoją pierwszą przestrzeń roboczą.</p>
        </div>
        {% else %}
        <!-- Siatka z tablicami -->
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
            {% for board in boards %}
            <a href="#" class="group block bg-white p-5 rounded-xl border border-slate-200 shadow-sm hover:border-indigo-500 hover:shadow-md transition">
                <div class="flex justify-between items-start mb-3">
                    <h3 class="font-bold text-slate-800 group-hover:text-indigo-600 transition text-base">
                        {{ board.name }}
                    </h3>
                    <span class="text-xs text-slate-400 bg-slate-50 px-2 py-1 rounded">
                                📋 0 zadań
                            </span>
                </div>
                <p class="text-xs text-slate-400 flex items-center gap-1 mt-auto">
                    📅 Utworzono: {{ board.createdAt|date('d.m.Y H:i') }}
                </p>

                <div class="mt-4 pt-3 border-t border-slate-100 flex justify-end text-xs text-indigo-600 font-semibold group-hover:underline">
                    Otwórz tablicę &rarr;
                </div>
            </a>
            {% endfor %}
        </div>
        {% endif %}
    </div>

</div>
{% endblock %}
