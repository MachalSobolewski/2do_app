<div id="column_{{ column.id }}" class="bg-slate-100 rounded-lg p-4 border border-slate-200 w-full md:w-80 shrink-0 column-item">

    <div class="flex justify-between items-center mb-3">
        <div class="flex items-center gap-2">
            <div class="flex gap-1 mr-1">
                <button class="move-btn text-xs bg-white border border-slate-300 px-1 rounded text-slate-500 hover:bg-slate-50 font-bold"
                        data-url="{{ path('board_column_move', {'id': column.id, 'direction': 'left'}) }}"><-</button>
                <button class="move-btn text-xs bg-white border border-slate-300 px-1 rounded text-slate-500 hover:bg-slate-50 font-bold"
                        data-url="{{ path('board_column_move', {'id': column.id, 'direction': 'right'}) }}">-></button>
            </div>

            <h3 class="font-bold text-slate-700 text-sm">{{ column.name }}</h3>
        </div>

        <div class="flex items-center gap-2">
            <a href="#" class="text-xs font-bold text-indigo-600 hover:text-indigo-800 bg-white border border-slate-200 px-2 py-0.5 rounded transition">
                + Dodaj
            </a>
            <span class="text-xs font-bold text-slate-500 bg-white border border-slate-200 px-1.5 py-0.5 rounded">
                {{ column.tasks|length }}
            </span>
        </div>
    </div>

    <div class="space-y-3">
        {% for task in column.tasks %}
            <div class="bg-white p-3 rounded border border-slate-200 shadow-sm">
                <h4 class="font-bold text-slate-800 text-sm">{{ task.title }}</h4>
            </div>
        {% else %}
            <div class="text-center p-4 border border-dashed border-slate-300 rounded text-slate-400 text-xs italic">
                Brak zadań
            </div>
        {% endfor %}
    </div>
</div>
