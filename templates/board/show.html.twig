{% extends 'base.html.twig' %}

{% block title %}{{ board.name }}{% endblock %}

{% block body %}
    <div class="border-b border-slate-250 pb-4 mb-6">
        <a href="{{ path('board_index') }}" class="text-xs text-indigo-600 hover:underline">&larr; Powrót do listy</a>
        <h1 class="text-2xl font-bold text-slate-800 mt-1">{{ board.name }}</h1>
    </div>

    <div class="flex flex-col md:flex-row gap-3 items-start overflow-x-auto pb-4" id="2todo-columns">

        {% for column in board.boardColumns %}
            {% include 'board_column/single_column.html.twig' with {'column': column} %}
        {% endfor %}

        <div class="bg-white p-4 rounded-lg border border-slate-200 w-full md:w-80 shrink-0 shadow-sm" id="form-container-box">
            <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Nowa kolumna</h4>

            {{ form_start(columnForm, {'attr': {'class': 'space-y-3', 'id': 'ajax-column-form'}}) }}
            {{ form_row(columnForm.name) }}
            {{ form_row(columnForm.save) }}
            {{ form_end(columnForm) }}
        </div>

    </div>

    <div id="task-modal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm hidden flex items-center justify-center z-50 transition-opacity">
        <div class="bg-white p-6 rounded-lg border border-slate-200 shadow-xl max-w-md w-full mx-4">

            <div class="mb-4">
                <h3 class="text-lg font-bold text-slate-800">Nowe zadanie</h3>
                <p class="text-xs text-slate-500 mt-0.5">Dodajesz do kolumny: <span id="modal-column-name" class="font-semibold text-slate-700"></span></p>
            </div>

            {{ form_start(taskForm, {'attr': {'id': 'popup-task-form', 'class': 'space-y-4'}}) }}
            {{ form_row(taskForm.name) }}
            {{ form_row(taskForm.description) }}

            <div class="flex items-center justify-between pt-2 border-t border-slate-100">
                <button type="button" id="close-task-modal-btn" class="text-sm text-slate-500 hover:text-slate-800">
                    Anuluj
                </button>
                {{ form_row(taskForm.save) }}
            </div>
            {{ form_end(taskForm) }}

        </div>
    </div>
    <div id="edit-column-modal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm hidden flex items-center justify-center z-50">
        <div class="bg-white p-6 rounded-lg border border-slate-200 shadow-xl max-w-sm w-full mx-4">

            <div class="mb-4">
                <h3 class="text-lg font-bold text-slate-800">Edytuj nazwę kolumny</h3>
            </div>

            {{ form_start(editColumnForm, {'attr': {'id': 'popup-edit-column-form', 'class': 'space-y-4'}}) }}
            {{ form_row(editColumnForm.name, {'id': 'edit-column-name-input'}) }}

            <div class="flex items-center justify-between pt-2 border-t border-slate-100">
                <button type="button" id="close-edit-column-modal-btn" class="text-sm text-slate-500 hover:text-slate-800 cursor-pointer">
                    Anuluj
                </button>
                <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold py-2 px-4 rounded transition cursor-pointer shadow-sm">
                    Zapisz zmiany
                </button>
            </div>

            {{ form_end(editColumnForm, {'render_rest': false}) }}

        </div>
    </div>
    <script src="{{ asset('Sortable.min.js') }}"></script>
    <script src="{{ asset('2doApp.js') }}"></script>
{% endblock %}
