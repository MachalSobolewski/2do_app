<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}2do App{% endblock %}</title>
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% endblock %}
</head>
<body class="bg-slate-50 text-slate-900 font-sans antialiased">

<nav class="bg-white border-b border-slate-200 py-4 px-6 flex justify-between items-center">
    <a href="{{ path('board_index') }}" class="font-bold text-lg text-indigo-600">2do App</a>
</nav>

<main class="mx-auto p-6">
    {% for message in app.flashes('success') %}
        <div class="mb-4 p-3 bg-green-50 text-green-700 text-xs rounded border border-green-200">
            {{ message }}
        </div>
    {% endfor %}
    {% block body %}{% endblock %}
</main>

</body>
</html>
